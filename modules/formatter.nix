{
  perSystem.treefmt = {
    projectRootFile = "flake.nix";
    settings.global.excludes = [
      # Generated by bd, which rewrites them.
      ".beads/**"
      ".agents/**"
      ".codex/**"
      "AGENTS.md"
      "CLAUDE.md"
      "flake.lock"
      "Cargo.lock"
    ];
    programs = {
      alejandra.enable = true;
      rustfmt = {
        enable = true;
        edition = "2024";
      };
      prettier = {
        enable = true;
        settings = {
          printWidth = 120;
          proseWrap = "always";
        };
      };
    };
  };
}
